<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.eventfinder.app</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/caffeinate</string><string>-i</string>
    <string>REPLACE_WITH_EVENTFINDER_VENV_PYTHON</string><string>-m</string><string>eventfinder.main</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_WITH_EVENTFINDER_PROJECT_ROOT</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>~/Library/Logs/EventFinder/stdout.log</string>
  <key>StandardErrorPath</key><string>~/Library/Logs/EventFinder/stderr.log</string>
</dict></plist>

